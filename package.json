{
  "name": "react-native-superqi",
  "version": "0.2.1",
  "description": "Expo native module for Qi Card and Super Qi payments (wraps the Qi payment SDK on iOS and Android).",
  "license": "MIT",
  "author": "Abbas Kareem",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abbasKareem/react-native-superQI.git"
  },
  "keywords": [
    "react-native",
    "expo",
    "qi-card",
    "superqi",
    "payments"
  ],
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "build/",
    "!build/**/__tests__",
    "plugin/build/",
    "!plugin/build/**/__tests__",
    "app.plugin.js",
    "expo-module.config.json",
    "ios/ReactNativeSuperQi.podspec",
    "ios/*.swift",
    "ios/Frameworks/",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "android/libs/",
    "android/src/main/",
    "README.md",
    "LICENSE",
    "MIGRATION.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf build plugin/build && tsc -p tsconfig.build.json && tsc -p plugin/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "prepack": "npm run build",
    "verify": "npm run typecheck && npm test && npm run build && npm pack --dry-run"
  },
  "peerDependencies": {
    "expo": ">=56.0.0",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "expo": "~57.0.26",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  }
}
